# BingX API 자격증명 — 이 파일을 .env 로 복사한 뒤 실제 값을 채울 것.
# .env 는 .gitignore 에 등록돼 있으며 절대 커밋하지 않는다.
BINGX_API_KEY=your_api_key_here
BINGX_SECRET_KEY=your_secret_key_here

# 아래 값들은 참고용 (실제 매매 파라미터는 config.py 에서 관리)
LEVERAGE=8
SYMBOL=BTC-USDT
BASE_ORDER_SIZE=60

# ── 선택: 아래 값은 .env 로 덮어쓸 수 있다 ────────────────
# config.py 를 직접 고치면 git pull 할 때 충돌이 난다.
# 폰(Termux)에서는 편집도 번거로우니 여기에 적는 편이 낫다.

# 봇 전용 서브계좌를 쓸 때 (권장)
#   잔고가 곧 자본이므로 기동 시 자동으로 맞춘다
# CAPITAL_AUTO_SYNC=true

# 자본을 직접 지정 (CAPITAL_AUTO_SYNC 를 켜면 필요 없다)
# TOTAL_CAPITAL=500

# 레버리지
# LEVERAGE=8

# 실주문 끄기 (관찰만 하고 싶을 때)
# LIVE_TRADING=false
