# ── 시크릿 (절대 커밋 금지) ──────────────────────────
.env
.env.*
!.env.example
*.key
*.pem

# ── 실행 상태 / 기록 (계정별 데이터) ─────────────────
state.json
state.json.bak
engine_state.json
governor_state.json
trades.jsonl
proposals/
report.txt
*_backup_*.json
_archive_*/

# ── 로그 / PID ───────────────────────────────────────
*.log
*.log.*
*.pid

# ── 파이썬 ───────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── 에디터 / 로컬 도구 ───────────────────────────────
.claude/
.vscode/
.idea/
*.bak_*

# ── 과거 기록 (history/) ─────────────────────────────
# 다른 PC 의 모의투자 기록을 여기에 복사해 두면 import_history.py 가 읽는다.
# reset_state.py 도 초기화할 때 여기로 옮긴다.
#
# ⚠ 이 저장소는 공개(public)다. 실거래 손익·잔고·매매 시각은 개인
#   금융 기록이므로 커밋하지 않는다. 예전에는 !history/ 로 추적을
#   허용했는데, 저장소를 공개로 바꾼 뒤로는 그대로 두면 그대로 노출된다.
#   폴더 구조만 남기고 내용은 전부 로컬에만 둔다.
history/
!history/README.txt
