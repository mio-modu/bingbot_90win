# ── 시크릿 (절대 커밋 금지) ──────────────────────────
.env
.env.*
!.env.example
*.key
*.pem

# ── 실행 상태 / 기록 (계정별 데이터) ─────────────────
state.json
state.json.bak
engine_state.json
governor_state.json
trades.jsonl
proposals/
report.txt
*_backup_*.json
_archive_*/

# ── 로그 / PID ───────────────────────────────────────
*.log
*.log.*
*.pid

# ── 파이썬 ───────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── 에디터 / 로컬 도구 ───────────────────────────────
.claude/
.vscode/
.idea/
*.bak_*

# ── 가져올 과거 기록 (history/) ──────────────────────
# 다른 PC 의 모의투자 기록을 여기에 복사해 두면 import_history.py 가 읽는다.
# 거래 기록은 추적하되 비밀은 어떤 경우에도 들어가지 않도록 재차단한다.
!history/
!history/**/*.json
!history/**/*.jsonl
!history/**/*.log
history/**/.env*
history/**/*.key
history/**/*.pem
